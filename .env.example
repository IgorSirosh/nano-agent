# NanoAgent v2.0 Configuration
# Оставьте ключи пустыми — их удобно задать прямо в веб-интерфейсе (Настройки)

# 1. Провайдер основного агента: Abliteration AI
BASE_URL=https://api.abliteration.ai/v1
ABLIT_KEY=
ADMIN_KEY=

# 2. OpenRouter API (опционально)
# BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=

# 3. Движок сжатия контекста (Active Memory)
# gemini_free — бесплатно через локальный agy CLI или GEMINI_API_KEY ($0 для основного баланса)
# main_api    — использовать основной платный API
DISTILL_ENGINE=gemini_free
GEMINI_API_KEY=

# Порт веб-сервера
PORT=5051
